# Documentation only; copy into Render secret settings. Never commit real values.
RIDENOVA_ENVIRONMENT=staging
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_HOST/ridenova_staging
RIDENOVA_PUBLIC_ORIGIN=https://YOUR-APP.onrender.com
# Each invited passenger gets an individually generated six-digit code, supplied
# privately by the administrator. This is test access, not SMS verification.
RIDENOVA_STAGING_TESTERS={"+16045550123":"735192"}
RIDENOVA_STAGING_DRIVER_PHONES=+16045550124
RIDENOVA_RATE_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
FORWARDED_ALLOW_IPS=*
